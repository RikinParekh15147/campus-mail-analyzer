{
  "$defs": {
    "Session": {
      "additionalProperties": false,
      "properties": {
        "course": {
          "title": "Course",
          "type": "string"
        },
        "weekday": {
          "maximum": 6,
          "minimum": 0,
          "title": "Weekday",
          "type": "integer"
        },
        "start": {
          "format": "time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "time",
          "title": "End",
          "type": "string"
        },
        "batch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch"
        },
        "location": {
          "default": "",
          "title": "Location",
          "type": "string"
        },
        "instructor": {
          "default": "",
          "title": "Instructor",
          "type": "string"
        }
      },
      "required": [
        "course",
        "weekday",
        "start",
        "end"
      ],
      "title": "Session",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "timezone": {
      "title": "Timezone",
      "type": "string"
    },
    "student_context": {
      "additionalProperties": true,
      "title": "Student Context",
      "type": "object"
    },
    "term_start": {
      "format": "date",
      "title": "Term Start",
      "type": "string"
    },
    "term_end": {
      "format": "date",
      "title": "Term End",
      "type": "string"
    },
    "sessions": {
      "items": {
        "$ref": "#/$defs/Session"
      },
      "title": "Sessions",
      "type": "array"
    },
    "exceptions": {
      "default": [],
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Exceptions",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "timezone",
    "student_context",
    "term_start",
    "term_end",
    "sessions"
  ],
  "title": "Timetable",
  "type": "object"
}
