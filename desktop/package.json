{
  "name": "campus-mail-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node scripts/start.cjs",
    "test": "node --test tests/*.test.cjs",
    "package": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.6.2",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "edu.campusmail.desktop",
    "productName": "Campus Mail",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/campusmail-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "electronDist": "node_modules/electron/dist"
  }
}
